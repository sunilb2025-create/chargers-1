<script>
"use strict";

const $ = id => document.getElementById(id);
const form = $("homeForm");
const resultsSection = $("results");
const errorBox = $("formError");
$("currentYear").textContent = new Date().getFullYear();

function money(value) {
  return new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: "INR",
    maximumFractionDigits: 0
  }).format(Math.max(0, value));
}

function clamp(value, min, max) {
  return Math.min(max, Math.max(min, value));
}

function showError(message) {
  errorBox.textContent = message;
  errorBox.classList.add("visible");
}

function clearError() {
  errorBox.textContent = "";
  errorBox.classList.remove("visible");
}

function read(id) {
  const element = $(id);
  if (!element) throw new Error("Missing field: " + id);
  return element.value;
}

function num(id) {
  return Number(read(id));
}

function scoreOption(value, scores) {
  return scores[value] ?? 0;
}

function getHomeData() {
  return {
    type: read("homeType"),
    bill: num("electricityBill"),
    kwh: num("monthlyKwh"),
    area: num("homeArea"),
    occupants: num("occupants"),
    age: read("homeAge"),
    lighting: read("lighting"),
    appliances: read("appliances"),
    cooling: read("cooling"),
    insulation: read("insulation"),
    daylight: read("daylight"),
    thermostat: read("thermostat"),
    solar: read("solar"),
    water: read("water"),
    waste: read("waste"),
    greenery: read("greenery"),
    transport: read("transport"),
    ventilation: read("ventilation")
  };
}

function validateData(data) {
  if (!Number.isFinite(data.bill) || data.bill < 0) {
    throw new Error("Enter a valid monthly electricity bill.");
  }

  if (!Number.isFinite(data.kwh) || data.kwh <= 0) {
    throw new Error("Enter a monthly electricity usage greater than zero.");
  }

  if (!Number.isFinite(data.area) || data.area < 50) {
    throw new Error("Enter a valid floor area of at least 50 sq. ft.");
  }

  if (!Number.isFinite(data.occupants) || data.occupants < 1) {
    throw new Error("Enter at least one occupant.");
  }
}

function calculateAnalysis(data) {
  const categories = {
    lighting: scoreOption(data.lighting, {
      led: 100, mixed: 60, traditional: 25
    }),
    appliances: scoreOption(data.appliances, {
      high: 100, medium: 60, low: 25
    }),
    cooling: scoreOption(data.cooling, {
      fan: 100, efficient: 75, older: 30
    }),
    insulation: scoreOption(data.insulation, {
      good: 100, average: 60, poor: 25
    }),
    daylight: scoreOption(data.daylight, {
      high: 100, medium: 65, low: 30
    }),
    thermostat: scoreOption(data.thermostat, {
      smart: 100, manual: 60, none: 25
    }),
    solar: scoreOption(data.solar, {
      yes: 100, planned: 50, no: 20
    }),
    water: scoreOption(data.water, {
      high: 100, some: 60, low: 25
    }),
    waste: scoreOption(data.waste, {
      yes: 100, sometimes: 55, no: 20
    }),
    greenery: scoreOption(data.greenery, {
      high: 100, some: 60, none: 25
    }),
    transport: scoreOption(data.transport, {
      often: 100, sometimes: 60, rarely: 25
    }),
    ventilation: scoreOption(data.ventilation, {
      good: 100, some: 60, poor: 25
    })
  };

  const values = Object.values(categories);
  const score = Math.round(values.reduce((sum, value) => sum + value, 0) / values.length);

  const lightingFactor = { led: .03, mixed: .07, traditional: .12 }[data.lighting];
  const applianceFactor = { high: .04, medium: .09, low: .16 }[data.appliances];
  const coolingFactor = { fan: .02, efficient: .08, older: .17 }[data.cooling];
  const insulationFactor = { good: .025, average: .07, poor: .13 }[data.insulation];
  const solarFactor = { yes: .20, planned: .04, no: 0 }[data.solar];

  const savingsRate = clamp(
    lightingFactor + applianceFactor + coolingFactor + insulationFactor + solarFactor,
    .05,
    .55
  );

  const estimatedSavings = Math.round(data.bill * savingsRate);
  const futureBill = Math.max(0, data.bill - estimatedSavings);

  return {
    data,
    categories,
    score,
    savingsRate,
    estimatedSavings,
    futureBill,
    annualSavings: estimatedSavings * 12
  };
}

function scoreDescription(score) {
  if (score >= 85) {
    return {
      title: "Excellent green foundation",
      description: "Your selections indicate strong sustainability practices. Focus on maintaining them and identifying further improvements.",
      status: "✦ Excellent foundation"
    };
  }

  if (score >= 70) {
    return {
      title: "A strong start",
      description: "Your home has several positive features. A few targeted upgrades may help improve efficiency further.",
      status: "✦ Good progress"
    };
  }

  if (score >= 50) {
    return {
      title: "Room to improve",
      description: "Your home could benefit from practical energy and resource-saving changes.",
      status: "✦ Improvement opportunities"
    };
  }

  return {
    title: "Start with small changes",
    description: "Focus first on simple, affordable efficiency improvements and review your energy use over time.",
    status: "✦ Start your green journey"
  };
}

function updateOverview(result) {
  $("overviewEnergy").textContent = result.data.kwh.toLocaleString("en-IN") + " kWh";
  $("overviewArea").textContent = result.data.area.toLocaleString("en-IN") + " sq. ft.";
  $("overviewScore").textContent = result.score + " / 100";
  $("overviewSavings").textContent = money(result.estimatedSavings);
}

function animateScore(score) {
  const number = $("greenScore");
  const ring = $("scoreRing");
  const start = performance.now();
  const duration = 1100;

  function step(now) {
    const progress = clamp((now - start) / duration, 0, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    number.textContent = Math.round(score * eased);
    ring.style.background =
      `conic-gradient(var(--emerald) ${score * 3.6 * eased}deg, #e2eaf3 0deg)`;

    if (progress < 1) requestAnimationFrame(step);
  }

  requestAnimationFrame(step);
}

function drawCostChart(result) {
  const canvas = $("costChart");
  const ctx = canvas.getContext("2d");
  const rect = canvas.getBoundingClientRect();
  const width = Math.max(280, rect.width);
  const height = Math.max(200, rect.height);
  const ratio = window.devicePixelRatio || 1;

  canvas.width = width * ratio;
  canvas.height = height * ratio;
  ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
  ctx.clearRect(0, 0, width, height);

  const left = 48;
  const right = 15;
  const top = 20;
  const bottom = 37;
  const chartW = width - left - right;
  const chartH = height - top - bottom;
  const maxVal = Math.max(result.data.bill, result.futureBill, 1) * 1.2;

  ctx.font = "10px DM Sans, sans-serif";
  ctx.textAlign = "right";
  ctx.textBaseline = "middle";

  for (let i = 0; i <= 4; i++) {
    const y = top + chartH - chartH * i / 4;
    const value = maxVal * i / 4;

    ctx.strokeStyle = "#e9eef5";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(left, y);
    ctx.lineTo(width - right, y);
    ctx.stroke();

    ctx.fillStyle = "#8492a6";
    ctx.fillText(
      value >= 1000 ? "₹" + Math.round(value / 1000) + "k" : "₹" + Math.round(value),
      left - 7,
      y
    );
  }

  const barWidth = Math.min(55, chartW * .23);
  const gap = chartW * .18;
  const x1 = left + chartW / 2 - barWidth - gap / 2;
  const x2 = left + chartW / 2 + gap / 2;

  const values = [result.data.bill, result.futureBill];
  const colors = ["#28d9a0", "#ffb66d"];
  const labels = ["Current", "Improved"];

  values.forEach((value, index) => {
    const barH = chartH * value / maxVal;
    const x = index === 0 ? x1 : x2;
    const y = top + chartH - barH;
    const gradient = ctx.createLinearGradient(0, y, 0, y + barH);
    gradient.addColorStop(0, colors[index]);
    gradient.addColorStop(1, index === 0 ? "#78eed0" : "#ffe0aa");

    ctx.fillStyle = gradient;
    roundedRect(ctx, x, y, barWidth, Math.max(2, barH), 8);
    ctx.fill();

    ctx.fillStyle = "#31465d";
    ctx.font = "bold 10px DM Sans, sans-serif";
    ctx.textAlign = "center";
    ctx.fillText(money(value), x + barWidth / 2, Math.max(10, y - 9));

    ctx.fillStyle = "#718097";
    ctx.font = "10px DM Sans, sans-serif";
    ctx.fillText(labels[index], x + barWidth / 2, height - 15);
  });
}

function roundedRect(ctx, x, y, width, height, radius) {
  const r = Math.min(radius, width / 2, height / 2);
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + width - r, y);
  ctx.quadraticCurveTo(x + width, y, x + width, y + r);
  ctx.lineTo(x + width, y + height - r);
  ctx.quadraticCurveTo(x + width, y + height, x + width - r, y + height);
  ctx.lineTo(x + r, y + height);
  ctx.quadraticCurveTo(x, y + height, x, y + height - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

function drawEfficiencyChart(result) {
  const canvas = $("efficiencyChart");
  const ctx = canvas.getContext("2d");
  const rect = canvas.getBoundingClientRect();
  const width = Math.max(280, rect.width);
  const height = Math.max(200, rect.height);
  const ratio = window.devicePixelRatio || 1;

  canvas.width = width * ratio;
  canvas.height = height * ratio;
  ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
  ctx.clearRect(0, 0, width, height);

  const entries = [
    ["Lighting", result.categories.lighting, "#28d9a0"],
    ["Appliances", result.categories.appliances, "#9c8cff"],
    ["Cooling", result.categories.cooling, "#76b9ff"],
    ["Insulation", result.categories.insulation, "#ff9fb8"],
    ["Renewables", result.categories.solar, "#ffbf72"]
  ];

  const left = 78;
  const right = 31;
  const top = 15;
  const rowH = 37;
  const barH = 9;
  const available = width - left - right;

  entries.forEach((entry, index) => {
    const y = top + index * rowH;

    ctx.fillStyle = "#6f7f94";
    ctx.font = "10px DM Sans, sans-serif";
    ctx.textAlign = "right";
    ctx.textBaseline = "middle";
    ctx.fillText(entry[0], left - 10, y + barH / 2);

    ctx.fillStyle = "#eaf0f6";
    roundedRect(ctx, left, y, available, barH, 5);
    ctx.fill();

    const fillW = available * entry[1] / 100;
    const gradient = ctx.createLinearGradient(left, 0, left + available, 0);
    gradient.addColorStop(0, entry[2]);
    gradient.addColorStop(1, "#b9e8ff");

    ctx.fillStyle = gradient;
    roundedRect(ctx, left, y, Math.max(1, fillW), barH, 5);
    ctx.fill();

    ctx.fillStyle = "#52647b";
    ctx.font = "bold 10px DM Sans, sans-serif";
    ctx.textAlign = "left";
    ctx.fillText(String(entry[1]), left + available + 7, y + barH / 2);
  });
}

function createProgressRows(result) {
  const container = $("energySummary");
  container.replaceChildren();

  const items = [
    ["Lighting efficiency", result.categories.lighting],
    ["Appliance efficiency", result.categories.appliances],
    ["Cooling efficiency", result.categories.cooling],
    ["Building envelope", result.categories.insulation],
    ["Sustainability features", Math.round(
      (result.categories.solar + result.categories.water +
      result.categories.waste + result.categories.greenery) / 4
    )]
  ];

  items.forEach(([label, value]) => {
    const row = document.createElement("div");
    row.className = "energy-row";

    const top = document.createElement("div");
    top.className = "energy-row-top";

    const title = document.createElement("span");
    title.textContent = label;

    const amount = document.createElement("span");
    amount.textContent = value + "%";

    top.append(title, amount);

    const track = document.createElement("div");
    track.className = "progress-track";

    const fill = document.createElement("div");
    fill.className = "progress-fill";
    fill.style.width = "0%";

    track.append(fill);
    row.append(top, track);
    container.append(row);

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        fill.style.width = value + "%";
      });
    });
  });
}

function buildRecommendations(result) {
  const { data, categories } = result;
  const list = $("recommendationList");
  list.replaceChildren();

  const suggestions = [];

  if (data.lighting !== "led") {
    suggestions.push({
      icon: "💡",
      title: "Upgrade to LED lighting",
      text: "Replace frequently used traditional bulbs with efficient LED lighting.",
      impact: "Low-cost starting point"
    });
  }

  if (data.appliances !== "high") {
    suggestions.push({
      icon: "🔌",
      title: "Review appliance efficiency",
      text: "Check energy labels when replacing appliances and avoid unnecessary standby use.",
      impact: "Potential ongoing savings"
    });
  }

  if (data.cooling === "older") {
    suggestions.push({
      icon: "❄️",
      title: "Improve cooling efficiency",
      text: "Clean filters, maintain equipment, and use comfortable temperature settings.",
      impact: "Improve comfort and efficiency"
    });
  }

  if (data.insulation !== "good") {
    suggestions.push({
      icon: "🏠",
      title: "Reduce unwanted heat gain",
      text: "Consider shading, sealing gaps, curtains, or insulation suitable for your climate.",
      impact: "Potential cooling benefits"
    });
  }

  if (data.solar !== "yes") {
    suggestions.push({
      icon: "☀️",
      title: "Explore solar feasibility",
      text: "Compare roof suitability, installation costs, local incentives, and actual energy use.",
      impact: "Requires a site-specific assessment"
    });
  }

  if (data.water !== "high") {
    suggestions.push({
      icon: "💧",
      title: "Use water more efficiently",
      text: "Repair leaks and consider efficient taps, showerheads, and other suitable fixtures.",
      impact: "Reduce water waste"
    });
  }

  if (data.ventilation !== "good") {
    suggestions.push({
      icon: "🌬️",
      title: "Improve natural ventilation",
      text: "Where safe and practical, use cross-ventilation and shading to reduce heat buildup.",
      impact: "May reduce cooling needs"
    });
  }

  if (data.waste !== "yes") {
    suggestions.push({
      icon: "♻️",
      title: "Separate household waste",
      text: "Set up simple bins for recyclable, organic, and general waste based on local rules.",
      impact: "Build a sustainable habit"
    });
  }

  if (data.greenery === "none") {
    suggestions.push({
      icon: "🌿",
      title: "Add suitable greenery",
      text: "Try locally suitable plants and choose species that match your available light and water.",
      impact: "Support a pleasant living space"
    });
  }

  if (suggestions.length === 0) {
    suggestions.push({
      icon: "✨",
      title: "Maintain your current habits",
      text: "Review energy bills periodically and look for improvements that make sense for your home.",
      impact: "Keep tracking progress"
    });
  }

  suggestions.slice(0, 6).forEach(item => {
    const article = document.createElement("article");
    article.className = "recommendation";

    const icon = document.createElement("div");
    icon.className = "recommendation-icon";
    icon.textContent = item.icon;

    const content = document.createElement("div");
    const title = document.createElement("h4");
    title.textContent = item.title;

    const description = document.createElement("p");
    description.textContent = item.text;

    const impact = document.createElement("span");
    impact.className = "recommendation-impact";
    impact.textContent = item.impact;

    content.append(title, description, impact);
    article.append(icon, content);
    list.append(article);
  });
}

function showResults(result) {
  const description = scoreDescription(result.score);

  $("scoreTitle").textContent = description.title;
  $("scoreDescription").textContent = description.description;
  $("scoreStatus").textContent = description.status;

  updateOverview(result);
  animateScore(result.score);
  createProgressRows(result);
  buildRecommendations(result);

  resultsSection.hidden = false;
  resultsSection.classList.remove("reveal");
  void resultsSection.offsetWidth;
  resultsSection.classList.add("reveal");

  requestAnimationFrame(() => {
    drawCostChart(result);
    drawEfficiencyChart(result);
  });
}

form.addEventListener("submit", event => {
  event.preventDefault();
  clearError();

  if (!form.reportValidity()) return;

  try {
    const data = getHomeData();
    validateData(data);
    const result = calculateAnalysis(data);

    showResults(result);

    setTimeout(() => {
      resultsSection.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });
    }, 100);

    showToast("Your home analysis is ready.", "success");
  } catch (error) {
    showError(error.message || "Something went wrong. Please check your entries.");
  }
});

/* RANGE TRACK AND VALUE LABELS */

function updateRange(slider) {
  const min = Number(slider.min || 0);
  const max = Number(slider.max || 100);
  const value = Number(slider.value);
  const percent = max > min ? ((value - min) / (max - min)) * 100 : 0;

  slider.style.setProperty("--range-fill", percent + "%");

  const output = slider.closest(".range-wrap")?.querySelector(".range-value");
  if (output) {
    output.textContent = slider.value;
    output.classList.remove("updated");
    void output.offsetWidth;
    output.classList.add("updated");
  }
}

document.querySelectorAll('input[type="range"]').forEach(slider => {
  slider.addEventListener("input", () => updateRange(slider));
  updateRange(slider);
});

/* NAVIGATION */

document.querySelectorAll(".nav-link").forEach(link => {
  link.addEventListener("click", () => {
    document.querySelectorAll(".nav-link").forEach(item => item.classList.remove("active"));
    link.classList.add("active");
  });
});

document.querySelectorAll("[data-scroll]").forEach(button => {
  button.addEventListener("click", () => {
    const target = document.querySelector(button.dataset.scroll);
    target?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
});

/* TOASTS */

let toastTimer;

function showToast(message, type = "success") {
  document.querySelector(".eco-toast")?.remove();
  clearTimeout(toastTimer);

  const toast = document.createElement("div");
  toast.className = "eco-toast " + type;
  toast.setAttribute("role", "status");
  toast.textContent = message;
  document.body.append(toast);

  toastTimer = setTimeout(() => {
    toast.style.transition = "opacity .25s ease, transform .25s ease";
    toast.style.opacity = "0";
    toast.style.transform = "translateY(-8px)";
    setTimeout(() => toast.remove(), 280);
  }, 3000);
}

/* CHAT WINDOW */

const chatLauncher = $("chatLauncher");
const chatWindow = $("chatWindow");
const chatClose = $("chatClose");
const chatMessages = $("chatMessages");
const chatForm = $("chatForm");
const chatInput = $("chatInput");

function openChat() {
  chatWindow.hidden = false;
  chatLauncher.setAttribute("aria-expanded", "true");
  setTimeout(() => chatInput.focus(), 50);
}

function closeChat() {
  chatWindow.hidden = true;
  chatLauncher.setAttribute("aria-expanded", "false");
  chatLauncher.focus();
}

chatLauncher.addEventListener("click", () => {
  if (chatWindow.hidden) openChat();
  else closeChat();
});

chatClose.addEventListener("click", closeChat);

document.addEventListener("keydown", event => {
  if (event.key === "Escape" && !chatWindow.hidden) closeChat();
});

function addChatMessage(text, type) {
  const message = document.createElement("div");
  message.className = "chat-message " + type;
  message.textContent = text;
  chatMessages.append(message);
  chatMessages.scrollTop = chatMessages.scrollHeight;
}

function getChatReply(question) {
  const q = question.toLowerCase();

  if (q.includes("score") || q.includes("green home")) {
    return "Your green home score is an illustrative score based on the choices in your assessment. It is designed to highlight opportunities, not certify a building.";
  }

  if (q.includes("bill") || q.includes("electricity") || q.includes("save energy")) {
    return "Start with efficient lighting, sensible cooling settings, regular appliance maintenance, and switching off equipment when it is not needed. Track your bills to see which changes help.";
  }

  if (q.includes("solar")) {
    return "Solar suitability depends on roof space, shade, local sunlight, installation cost, electricity tariffs, and available incentives. Compare quotations and expected generation before deciding.";
  }

  if (q.includes("water")) {
    return "Repair leaks, choose suitable efficient fixtures, and use water only when needed. Local climate and water availability should guide larger changes.";
  }

  if (q.includes("ventilation") || q.includes("cooling") || q.includes("hot")) {
    return "Where safe and practical, cross-ventilation, shading, clean cooling filters, and well-managed temperature settings can improve comfort and may reduce energy use.";
  }

  if (q.includes("waste") || q.includes("recycl")) {
    return "Separate waste according to your local collection rules. Keep recyclables clean, and compost suitable food scraps where facilities and conditions allow.";
  }

  return "A good place to start is your home assessment. I can offer general guidance about energy efficiency, solar power, water conservation, waste reduction, and sustainable home habits.";
}

function sendChatQuestion(question) {
  const cleaned = question.trim();
  if (!cleaned) return;

  addChatMessage(cleaned, "user");
  chatInput.value = "";

  const typing = document.createElement("div");
  typing.className = "chat-message bot";
  typing.textContent = "Thinking…";
  typing.id = "chatTyping";
  chatMessages.append(typing);
  chatMessages.scrollTop = chatMessages.scrollHeight;

  setTimeout(() => {
    $("chatTyping")?.remove();
    addChatMessage(getChatReply(cleaned), "bot");
  }, 450);
}

chatForm.addEventListener("submit", event => {
  event.preventDefault();
  sendChatQuestion(chatInput.value);
});

document.querySelectorAll("[data-question]").forEach(button => {
  button.addEventListener("click", () => sendChatQuestion(button.dataset.question));
});

/* PRINT */

$("printResults").addEventListener("click", () => window.print());

/* REDRAW CHARTS AFTER RESIZE */

let resizeTimer;

window.addEventListener("resize", () => {
  clearTimeout(resizeTimer);

  resizeTimer = setTimeout(() => {
    if (resultsSection.hidden) return;

    try {
      const result = calculateAnalysis(getHomeData());
      drawCostChart(result);
      drawEfficiencyChart(result);
    } catch (error) {
      console.warn("Chart refresh skipped:", error.message);
    }
  }, 150);
});
